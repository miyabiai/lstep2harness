{
  "name": "lstep2harness",
  "version": "0.1.0",
  "private": true,
  "description": "Lステップの顧客データを L Harness（line-harness-oss）へ移行・照合する非公式ツール",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lstep2harness": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "smoke": "node scripts/local-smoke.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "playwright-core": "^1.64.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
