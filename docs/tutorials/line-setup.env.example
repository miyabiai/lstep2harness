# L Harness 新規セットアップ用: LINE 接続情報の空欄の見本
# この公開用の見本には、実際の値を保存しないでください。
# AI が案内する保護された保存先へ、必要な項目だけコピーして使います。
# 移行ツールの .env / HARNESS_API_KEY とは別のファイルです。

# Messaging API チャネル
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 同じプロバイダー内の LINE ログインチャネル
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# L Harness 用に作成した LIFF アプリ
LIFF_ID=
